@page
@model DevDigest.Web.Pages.ArticlesModel

<h1>Developer Digest</h1>

<p>Latest developer articles from .NET and GitHub.</p>

<p><strong>Total Articles:</strong> @Model.Articles.Count</p>

@foreach (var article in Model.Articles)
{
    <div style="margin-bottom:24px; padding:20px; border:1px solid #ddd; border-radius:8px;">

        <h3>
            <a href="@article.Url" target="_blank">
                @article.Title
            </a>
        </h3>

        <p>
            <strong>@article.Source</strong> |
            @article.PublishedAt.ToShortDateString()
        </p>

        <p>
            <strong>Category:</strong> @article.Category
        </p>

        <p>
            <strong>AI Summary</strong>
        </p>

        <p>@article.AiSummary</p>

        <p>
            <strong>Key Takeaways</strong>
        </p>

        <p style="white-space: pre-line;">
            @article.KeyTakeaways
        </p>

    </div>
}