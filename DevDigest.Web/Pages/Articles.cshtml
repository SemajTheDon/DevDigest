@page
@model DevDigest.Web.Pages.ArticlesModel

<div class="digest-container">

    <header class="digest-header">
        <h1 class="digest-title">DevDigest</h1>
        <button id="themeToggle">
            🌙 Dark Mode
        </button>
        <p class="digest-subtitle">
            AI-assisted developer learning dashboard for .NET, GitHub, Azure, and cloud engineering.
        </p>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <h2>@Model.TotalArticles</h2>
            <p>Total Articles</p>
        </div>

        <div class="stat-card">
            <h2>@Model.DotNetCount</h2>
            <p>.NET</p>
        </div>

        <div class="stat-card">
            <h2>@Model.GitHubCount</h2>
            <p>GitHub</p>
        </div>

        <div class="stat-card">
            <h2>@Model.CloudCount</h2>
            <p>Cloud</p>
        </div>

        <div class="stat-card">
            <h2>@Model.AiCount</h2>
            <p>AI</p>
        </div>
    </div>
    <section class="dashboard-bar">
        <form method="get" class="filter-form">
            <input class="search-box" asp-for="SearchTerm" placeholder="Search articles..." />

            <select class="sort-select" asp-for="SortBy" onchange="this.form.submit()">
                <option>Newest</option>
                <option>Oldest</option>
                <option>Source</option>
            </select>
        </form>

        <div class="filter-row">
            <a class="filter-pill @(string.IsNullOrWhiteSpace(Model.Category) ? "active" : "")" asp-page="/Articles">
                All
            </a>

            <a class="filter-pill @(Model.Category == ".NET" ? "active" : "")" asp-page="/Articles"
               asp-route-category=".NET" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                .NET
            </a>

            <a class="filter-pill @(Model.Category == "GitHub" ? "active" : "")" asp-page="/Articles"
               asp-route-category="GitHub" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                GitHub
            </a>

            <a class="filter-pill @(Model.Category == "Cloud" ? "active" : "")" asp-page="/Articles"
               asp-route-category="Cloud" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                Cloud
            </a>

            <a class="filter-pill @(Model.Category == "AI" ? "active" : "")" asp-page="/Articles"
               asp-route-category="AI" asp-route-searchTerm="@Model.SearchTerm" asp-route-sortBy="@Model.SortBy">
                AI
            </a>
        </div>
    </section>

    <p><strong>Total Articles:</strong> @Model.Articles.Count</p>

    @if (!Model.Articles.Any())
    {
        <div class="empty-state">
            <h2>No articles found</h2>
            <p>Import RSS feeds to begin building your developer digest.</p>
        </div>
    }
    else
    {
        <section class="article-grid">
            @foreach (var article in Model.Articles)
            {
                <article class="article-card">

                    <div class="article-meta">
                        <span class="badge">@article.Source</span>
                        <span>@article.PublishedAt.ToShortDateString()</span>
                        <span class="category-badge">@article.Category</span>
                    </div>

                    <h2 class="article-title">
                        <a href="@article.Url" target="_blank">
                            @article.Title
                        </a>
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(article.AiSummary))
                    {
                        <div class="mt-2">
                            <strong>🤖 AI Summary</strong>

                            <p>@article.AiSummary</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(article.KeyTakeaways))
                    {
                        <div class="mt-2">
                            <strong>📌 Key Takeaways</strong>

                            <pre style="white-space: pre-wrap;">
                                @article.KeyTakeaways
                            </pre>
                        </div>
                    }

                    <a class="read-link" href="@article.Url" target="_blank">
                        Read article →
                    </a>

                </article>
            }
        </section>
    }

</div>

@section Scripts {

}